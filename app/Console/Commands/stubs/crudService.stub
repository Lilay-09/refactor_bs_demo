<?php

namespace {{ namespace }};
use Illuminate\Http\Request;
use App\Models\{{ model }};
use DataResponse;

class {{ class }}
{
    private function {{ method }}Validation(Request $req){
        return validator($req->all(),{{ rule }});
    }
    // Your service methods go here
    public function create{{ method }}(Request $req,$user){
        $validate = $this->{{ method }}Validation($req);
        if($validate->fails()) return DataResponse::ValidateFail($validate->errors()->first());
        $inputs = $validate->validated();
        $inputs['create_uid'] = $user->id;
        $inputs['update_uid'] = $user->id;
        $inputs['company_id'] = $user->company_id;
        $inputs['branch_id'] = $user->branch_id;
        {{ model }}::create($inputs);
        return DataResponse::JsonResult(null,false,"Created");
    }

    public function update{{ method }} (Request $req,int $id,$user){
        ${{ model }} = {{ model }}::where('is_deleted',0)->find($id);
        if(!${{ model }}) return DataResponse::NotFound("{{ model }} not found");
        $validate = $this->{{ method }}Validation($req);
        if($validate->fails()) return DataResponse::ValidateFail($validate->errors()->first());
        $inputs = $validate->validated();
        $inputs['update_uid'] = $user->id;
        $inputs['company_id'] = $user->company_id;
        $inputs['branch_id'] = $user->branch_id;
        ${{ model }}->update($inputs);
        return DataResponse::JsonResult(null,false,"Updated");
    }

    public function get{{ method }}(Request $req,$user){
        ${{ model }} = {{ model }}::query()->where('is_deleted',0);
        return DataResponse::PaginationV1(${{ model }},$req);
    }

    public function getOne{{ method }}(int $id,$user){
        ${{ model }} = {{ model }}::where('is_deleted',0)->find($id);
        if(!${{ model }}) return DataResponse::NotFound("{{ model }} not found");
        return DataResponse::JsonResult(${{ model }},false,"get one {{ model }}");
    }

    public function delete{{ method }}(int $id,$user){
        ${{ model }} = {{ model }}::where('is_deleted',0)->find($id);
        if(!${{ model }}) return DataResponse::NotFound("{{ model }} not found");
        ${{ model }}->update([
            'is_deleted' => 1,
            'deleted_uid' => $user->id,
            'deleted_datetime'=> now()
        ]);
        return DataResponse::JsonResult(null,false,"Deleted");
    }
}
